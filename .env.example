# HalGuard 配置示例（复制为 .env 后按需修改；.env 已被 .gitignore 忽略）
# 所有项均可选，不设则用 halguard/config.py 中的默认值。

# ---- 默认后端（本地 LLM，OpenAI 兼容）----
HALGUARD_BACKEND_BASE_URL=http://localhost:11434/v1
HALGUARD_BACKEND_API_KEY=ollama
HALGUARD_BACKEND_MODEL=llama3.1:8b

# ---- 代理监听 ----
# HALGUARD_LISTEN_HOST=0.0.0.0
# HALGUARD_LISTEN_PORT=8849

# ---- 嵌入与检索 ----
# HALGUARD_EMBEDDER=auto            # auto | st | tfidf
# HALGUARD_ST_MODEL=/models/paraphrase-multilingual-MiniLM-L12-v2   # Docker 内路径
# HALGUARD_TOP_K=5

# ---- 验证与策略 ----
# HALGUARD_SUPPORT_THRESHOLD=0.35
# HALGUARD_RISK_THRESHOLD=0.30
# HALGUARD_ACTION_ON_RISK=flag       # flag | redact | reask | none
# HALGUARD_CLAIM_EXTRACTION=heuristic # heuristic | llm
# HALGUARD_APPEND_WARNING=true

# ---- 联网搜索开关 ----
# HALGUARD_WEBSEARCH=0               # 1=默认开启（也可在请求里传 "websearch": true 按次覆盖）
# HALGUARD_WEBSEARCH_MAX_RESULTS=5
# HALGUARD_WEBSEARCH_TIMEOUT=10.0
# HALGUARD_WEBSEARCH_MIN_MAX_TOKENS=4096

# ---- 路径 ----
# HALGUARD_KB_PATH=./knowledge
# HALGUARD_INDEX_PATH=./.halguard_index

# ---- Docker Compose 专用 ----
# HALGUARD_MODELS_DIR=../halguard_models   # 本地嵌入模型目录（挂载到容器 /models）
# TZ=Asia/Shanghai
